{
	"expo": {
		"name": "panaderia-frontend",
		"slug": "panaderia-frontend",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "myapp",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.andremar93.panaderiafrontend",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "com.andremar93.panaderiafrontend"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"@sentry/react-native/expo",
				{
					"url": "https://sentry.io/",
					"project": "react-native",
					"organization": "buenos-panes"
				}
			],
			"expo-web-browser",
			"expo-font",
			"expo-dev-client"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "4991ccbd-b20f-42bc-8c82-40e2b356aa29"
			}
		}
	},
	"cli": {
		"appVersionSource": "app.json"
	}
}